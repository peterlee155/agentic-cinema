# Agentic Cinema — Google Cloud & RevenueCat Configuration

# 1. Path to your Google Cloud Service Account JSON Key File
GOOGLE_APPLICATION_CREDENTIALS="c:\Networking\Agentic Cenima\gcp-key.json"

# 2. Google Cloud Project ID
GOOGLE_CLOUD_PROJECT="seismic-relic-447818-r2"
GCP_PROJECT_ID="seismic-relic-447818-r2"

# 3. Enable Vertex AI & Gemini API
USE_VERTEX_AI="true"
GEMINI_API_KEY=""

# 4. Google Cloud Storage Bucket
GCS_BUCKET_NAME="agentic-cinema-projects"

# 5. RevenueCat Monetization & Web Billing
